# Supabase project settings (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — bypasses Row Level Security. Never expose this to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Supabase Postgres connection string. Click "Connect" in the Supabase
# dashboard > Connection String > URI, and use the "Session pooler" option
# (IPv4-compatible; the default "Transaction pooler" is IPv6-only and can
# hang from networks without solid IPv6 routing, including some build
# environments). Replace [YOUR-PASSWORD] with your database password.
DATABASE_URL=
